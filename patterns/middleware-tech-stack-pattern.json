{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://example.com/patterns/middleware-tech-stack-pattern.json",
  "title": "Middleware Tech Stack Pattern",
  "description": "Enforces the approved API middleware/gateway platform (Azure API Management) on the api-gateway node.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "api-gateway" },
            "technology": {
              "const": {
                "platform": "Azure API Management",
                "policy-language": "XML inbound/outbound policies",
                "deployment": "Azure-managed"
              }
            }
          },
          "required": ["unique-id", "technology"]
        }
      ]
    },
    "relationships": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": ["nodes"]
}
