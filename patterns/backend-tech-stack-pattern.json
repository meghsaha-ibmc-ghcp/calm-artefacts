{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://example.com/patterns/backend-tech-stack-pattern.json",
  "title": "Backend Tech Stack Pattern",
  "description": "Enforces the approved backend microservice technology stack (ASP.NET Core / C#) on the balance-service node, consistent with the BankSystem repository.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "balance-service" },
            "technology": {
              "const": {
                "framework": "ASP.NET Core",
                "language": "C#",
                "runtime": ".NET 8",
                "api-style": "REST, BIAN-aligned"
              }
            }
          },
          "required": ["unique-id", "technology"]
        }
      ]
    },
    "relationships": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": ["nodes"]
}
