{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://example.com/patterns/company-base-pattern.json",
  "title": "Company Base Pattern",
  "description": "A reusable CALM pattern that enforces organizational node and relationship standards across architectures.",
  "type": "object",
  "properties": {
    "unique-id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "https://example.com/standards/company-node-standard.json"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://example.com/standards/company-relationship-standard.json"
      }
    }
  },
  "required": [
    "unique-id",
    "name",
    "description",
    "nodes",
    "relationships"
  ]
}
