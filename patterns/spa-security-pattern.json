{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://example.com/patterns/spa-security-pattern.json",
  "title": "SPA Security Controls Pattern",
  "description": "Security controls companion for the SPA pattern. Enforces CSP on the CDN, OAuth2 PKCE on the Identity Provider, and CORS with bearer-token validation on the API Gateway.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "cdn" },
            "controls": {
              "const": {
                "content-security": {
                  "description": "Content Security Policy enforcement for the CDN",
                  "requirements": [
                    {
                      "requirement-url": "https://internal-policy.example.com/security/csp-strict",
                      "config": {
                        "default-src": "'self'",
                        "script-src": "'self'",
                        "style-src": "'self'",
                        "object-src": "'none'"
                      }
                    },
                    {
                      "requirement-url": "https://internal-policy.example.com/security/tls-1-3-minimum",
                      "config-url": "https://configs.example.com/security/tls-config.yaml"
                    }
                  ]
                }
              }
            }
          },
          "required": ["unique-id", "controls"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "spa-client" }
          },
          "required": ["unique-id"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "identity-provider" },
            "controls": {
              "const": {
                "authentication": {
                  "description": "OAuth2 PKCE flow and token security requirements",
                  "requirements": [
                    {
                      "requirement-url": "https://internal-policy.example.com/security/oauth2-pkce-required",
                      "config": {
                        "grant-type": "authorization_code",
                        "pkce": true,
                        "token-expiry-seconds": 3600
                      }
                    },
                    {
                      "requirement-url": "https://internal-policy.example.com/security/mfa-required",
                      "config-url": "https://configs.example.com/security/mfa-policy.yaml"
                    }
                  ]
                }
              }
            }
          },
          "required": ["unique-id", "controls"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "api-gateway" },
            "controls": {
              "const": {
                "security": {
                  "description": "CORS policy and bearer token validation at the API Gateway",
                  "requirements": [
                    {
                      "requirement-url": "https://internal-policy.example.com/security/cors-strict",
                      "config": {
                        "allowed-origins": ["https://app.example.com"],
                        "allowed-methods": ["GET", "POST", "PUT", "DELETE"],
                        "allow-credentials": true
                      }
                    },
                    {
                      "requirement-url": "https://internal-policy.example.com/security/bearer-token-validation",
                      "config": {
                        "algorithm": "RS256",
                        "jwks-url": "https://identity.example.com/.well-known/jwks.json"
                      }
                    }
                  ]
                }
              }
            }
          },
          "required": ["unique-id", "controls"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "backend-service" },
            "controls": {
              "const": {
                "transport-security": {
                  "description": "Mutual TLS for internal service-to-service communication",
                  "requirements": [
                    {
                      "requirement-url": "https://internal-policy.example.com/security/mtls-internal",
                      "config": {
                        "mode": "mutual",
                        "min-tls-version": "1.3"
                      }
                    }
                  ]
                }
              }
            }
          },
          "required": ["unique-id", "controls"]
        }
      ]
    },
    "relationships": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "cdn-to-spa-client" },
            "description": { "type": "string" },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": { "node": "cdn" },
                  "destination": { "node": "spa-client" }
                }
              }
            }
          },
          "required": ["unique-id", "relationship-type", "description"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "spa-client-to-identity-provider" },
            "description": { "type": "string" },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": { "node": "spa-client" },
                  "destination": { "node": "identity-provider" }
                }
              }
            }
          },
          "required": ["unique-id", "relationship-type", "description"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "spa-client-to-api-gateway" },
            "description": { "type": "string" },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": { "node": "spa-client" },
                  "destination": { "node": "api-gateway" }
                }
              }
            }
          },
          "required": ["unique-id", "relationship-type", "description"]
        },
        {
          "type": "object",
          "properties": {
            "unique-id": { "const": "api-gateway-to-backend-service" },
            "description": { "type": "string" },
            "relationship-type": {
              "const": {
                "connects": {
                  "source": { "node": "api-gateway" },
                  "destination": { "node": "backend-service" }
                }
              }
            }
          },
          "required": ["unique-id", "relationship-type", "description"]
        }
      ]
    }
  },
  "required": ["nodes", "relationships"]
}
